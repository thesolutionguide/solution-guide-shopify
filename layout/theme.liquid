<!doctype html>
<html lang="{{ shop.locale }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#e8e4de">
    <title>{{ page_title }}</title>
    <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body>
    <!-- Header -->
    <header>
      <div class="header-wrapper">
        <div class="logo-container">
          <div class="logo-icon">
            <svg width="26" height="26" viewBox="0 0 100 100" fill="none" stroke="#8b8680" stroke-width="2.5">
              <line x1="50" y1="15" x2="50" y2="85"></line>
              <line x1="40" y1="25" x2="60" y2="25"></line>
              <line x1="35" y1="35" x2="65" y2="35"></line>
              <line x1="30" y1="45" x2="70" y2="45"></line>
              <line x1="35" y1="55" x2="65" y2="55"></line>
              <line x1="40" y1="65" x2="60" y2="65"></line>
              <line x1="45" y1="75" x2="55" y2="75"></line>
            </svg>
          </div>
          <div>
            <div class="logo-text">THE SOLUTION GUIDE</div>
          </div>
        </div>
        
        <nav>
          <a href="/collections/all">Guides</a>
          <a href="#why">Why Us</a>
          <a href="#reviews">Reviews</a>
          <a href="#faq">FAQ</a>
          <button class="cart-btn" onclick="ShopifyCart.openCart()">
            🛒 Cart
            <span class="cart-count" style="display: none;">0</span>
          </button>
        </nav>
      </div>
    </header>

    <main role="main">
      {{ content_for_layout }}
    </main>

    <!-- Footer -->
    <footer>
      <div class="footer-container">
        <div class="footer-content">
          <div class="footer-section footer-about">
            <h3>The Solution Guide</h3>
            <p>Practical, research-grounded guides for people who'd rather build real connection than perform it.</p>
            <div class="social-links">
              <a href="#" title="Instagram">📷</a>
              <a href="#" title="Facebook">f</a>
              <a href="#" title="Twitter">𝕏</a>
            </div>
          </div>
          
          <div class="footer-section">
            <h3>Shop</h3>
            <ul>
              <li><a href="/collections/all">All Guides</a></li>
              <li><a href="#">Bundle Deals</a></li>
              <li><a href="#">Gift Cards</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h3>Support</h3>
            <ul>
              <li><a href="#">Contact</a></li>
              <li><a href="#">FAQ</a></li>
              <li><a href="#">Shipping & Returns</a></li>
              <li><a href="#">Refund Policy</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h3>Company</h3>
            <ul>
              <li><a href="#">About Us</a></li>
              <li><a href="#">Blog</a></li>
              <li><a href="#">Privacy Policy</a></li>
              <li><a href="#">Terms & Conditions</a></li>
            </ul>
          </div>
        </div>
        
        <div class="footer-bottom">
          <p>&copy; 2024 The Solution Guide. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="{{ 'cart.js' | asset_url }}" defer></script>
  </body>
</html>