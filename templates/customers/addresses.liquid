{% layout none %}
<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Addresses - {{ shop.name }}</title>
  <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
  <style>
    .account-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 20px;
    }
    .account-nav {
      display: grid;
      grid-template-columns: 250px 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }
    .account-sidebar {
      background: #f5f3f0;
      padding: 25px;
      border-radius: 8px;
      height: fit-content;
    }
    .account-sidebar a {
      display: block;
      padding: 12px 0;
      color: #6b7060;
      font-size: 14px;
      letter-spacing: 0.5px;
      border-bottom: 1px solid #e8e5e0;
      transition: color 0.3s;
    }
    .account-sidebar a:hover {
      color: #2c2c2c;
    }
    .account-content h2 {
      font-size: 32px;
      font-weight: 300;
      letter-spacing: 1.5px;
      margin-bottom: 25px;
    }
    .address-item {
      background: white;
      border: 1px solid #e8e5e0;
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 20px;
    }
    .address-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }
  </style>
</head>
<body>
  <header>
    <div class="header-wrapper">
      <div class="logo-container">
        <a href="/" class="logo-text">THE SOLUTION GUIDE</a>
      </div>
      <nav>
        <a href="/account/logout">Logout</a>
      </nav>
    </div>
  </header>

  <div class="account-container">
    <div class="account-nav">
      <div class="account-sidebar">
        <a href="/account">Dashboard</a>
        <a href="/account/orders">Orders</a>
        <a href="/account/addresses">Addresses</a>
        <a href="/account/logout">Logout</a>
      </div>
      
      <div class="account-content">
        <h2>Saved Addresses</h2>
        
        <div class="address-grid">
          {% for address in customer.addresses %}
            <div class="address-item">
              <p><strong>{{ address.first_name }} {{ address.last_name }}</strong></p>
              <p style="color: #6b7060; margin-top: 8px;">{{ address.street }}<br>{{ address.city }}, {{ address.province }} {{ address.zip }}</p>
              <p style="color: #6b7060; margin-top: 8px;">{{ address.country }}</p>
              <div style="margin-top: 15px;">
                <a href="{{ address.url }}" style="color: #6b7060; text-decoration: underline; font-size: 13px; margin-right: 15px;">Edit</a>
                <a href="{{ address.delete_url }}" style="color: #c0392b; text-decoration: underline; font-size: 13px;" onclick="return confirm('Are you sure?')">Delete</a>
              </div>
            </div>
          {% endfor %}
        </div>
        
        <button class="cta-button" style="margin-top: 30px;">Add New Address</button>
      </div>
    </div>
  </div>
  
  <footer>
    <div class="footer-container">
      <div class="footer-bottom">
        <p>&copy; 2024 The Solution Guide. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>