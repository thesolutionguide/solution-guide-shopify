<section class="hero-section">
  <div class="hero-content">
    <div class="hero-logo">
      <svg width="60" height="60" viewBox="0 0 100 100" fill="none" stroke="#8b8680" stroke-width="2">
        <line x1="50" y1="15" x2="50" y2="85"></line>
        <line x1="40" y1="25" x2="60" y2="25"></line>
        <line x1="35" y1="35" x2="65" y2="35"></line>
        <line x1="30" y1="45" x2="70" y2="45"></line>
        <line x1="35" y1="55" x2="65" y2="55"></line>
        <line x1="40" y1="65" x2="60" y2="65"></line>
        <line x1="45" y1="75" x2="55" y2="75"></line>
      </svg>
    </div>
    
    <p class="tagline">TWO GUIDES. ONE QUIETER WAY FORWARD.</p>
    
    <h1>Guidance for growth.<br><span class="italic">Solutions for life.</span></h1>
    
    <p class="hero-subtitle">Two practical, research-grounded guides for people who'd rather build real connection than perform it — at work, and everywhere else. Written for readers who think before they speak.</p>
    
    <div class="hero-buttons">
      <button class="btn-primary" onclick="document.querySelector('.library-section').scrollIntoView({behavior:'smooth'})">BROWSE THE GUIDES →</button>
      <button class="btn-secondary" onclick="document.querySelector('#why').scrollIntoView({behavior:'smooth'})">WHY THESE GUIDES WORK</button>
    </div>
    
    <div class="trust-badges">
      <div class="badge-item">⭐ 4.9 / 5 average rating</div>
      <div class="badge-item">Instant PDF download</div>
      <div class="badge-item">Secure checkout via Stripe</div>
    </div>
  </div>
</section>

<div class="section-divider"></div>

<section class="library-section">
  <div class="library-container">
    <p class="section-label">THE LIBRARY</p>
    <h2>Two guides. Two different<br>rooms in life.</h2>
    <p class="subtitle">Each one stands on its own. Together, they cover the two places connection matters most — your career, and everyone else.</p>
    
    <div class="products-grid">
      {% for product in collections.all.products %}
        <div class="product-card" data-product-id="{{ product.id }}">
          <div class="product-image">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '400x400' }}" alt="{{ product.title }}" loading="lazy">
            {% else %}
              <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #e8e4de 0%, #ddd8d0 100%); display: flex; align-items: center; justify-content: center;">
                <span style="color: #8b8680;">{{ product.title }}</span>
              </div>
            {% endif %}
            {% if product.metafields.guide.badge %}
              <div class="product-badge">{{ product.metafields.guide.badge }}</div>
            {% else %}
              <div class="product-badge">{{ forloop.index | abs | minus: 1 | modulo: 2 | times: 1 | replace: '1', 'NEW RELEASE' | replace: '0', 'BESTSELLER' }}</div>
            {% endif %}
          </div>
          
          <div class="product-info">
            {% if product.type %}
              <p class="product-category">{{ product.type }}</p>
            {% else %}
              <p class="product-category">{% if forloop.index == 1 %}FOR ANYONE, ANYWHERE{% else %}FOR THE WORKPLACE{% endif %}</p>
            {% endif %}
            
            <h3 class="product-title">{{ product.title }}</h3>
            
            <p class="product-description">{{ product.description | strip_html | truncatewords: 25 }}</p>
            
            <div class="product-meta">
              <div class="product-specs">
                <span>📄 PDF · {% if product.metafields.guide.pages %}{{ product.metafields.guide.pages }}{% else %}24{% endif %} pages</span>
                <span>⚡ Instant delivery</span>
              </div>
            </div>
            
            <div class="product-price-section">
              <span class="product-price">${{ product.price | money_without_currency }}</span>
              {% if product.compare_at_price %}
                <span class="product-original-price">${{ product.compare_at_price | money_without_currency }}</span>
              {% endif %}
            </div>
            
            <p class="product-purchase-type">One-time purchase</p>
            
            <button class="add-to-cart-btn" data-title="{{ product.title }}" data-price="{{ product.price | money_without_currency }}">+ ADD TO CART</button>
          </div>
        </div>
      {% endfor %}
    </div>
    
    <!-- Bundle Section -->
    <div class="bundle-section">
      <div class="bundle-image">
        <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 150 180'%3E%3Crect fill='%23ddd8d0' width='150' height='180'/%3E%3Ctext x='75' y='90' text-anchor='middle' font-size='14' fill='%238b8680' font-family='serif'%3EBoth Guides%3C/text%3E%3C/svg%3E" alt="Bundle">
      </div>
      <div class="bundle-content">
        <h3>Get both guides, the complete set</h3>
        <p>Work and life, covered — delivered together as one download.</p>
      </div>
      <div class="bundle-price">
        <div class="bundle-discount">SAVE 20%</div>
        <div class="bundle-price-amount">$30.00</div>
        <div class="bundle-original">$38.00</div>
        <button class="btn-bundle">+ ADD BUNDLE</button>
      </div>
    </div>
  </div>
</section>

<div class="section-divider"></div>

